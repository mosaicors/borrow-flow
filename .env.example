# All optional. With nothing set, the API starts an in-memory MongoDB.

# Use a real MongoDB instead of the in-memory one.
# MONGODB_URI=mongodb://localhost:27017
# MONGODB_DB=borrow_flow

# Port of the tRPC API process (HTTP and WebSocket).
# API_PORT=3001

# Where Next.js forwards /api/trpc. Change together with API_PORT.
# API_ORIGIN=http://localhost:3001

# WebSocket address the browser connects to. Defaults to ws://<page host>:3001.
# NEXT_PUBLIC_WS_URL=ws://localhost:3001
