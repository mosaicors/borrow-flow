{
  "name": "borrow-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "next dev",
    "build": "next build",
    "start": "concurrently -k -n api,web -c blue,green \"npm:start:api\" \"npm:start:web\"",
    "start:api": "tsx src/server/index.ts",
    "start:web": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run lint && npm run typecheck && npm test"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.107.1",
    "@trpc/client": "^11.28.2",
    "@trpc/react-query": "^11.28.2",
    "@trpc/server": "^11.28.2",
    "mongodb": "^7.9.0",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.7",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=22"
  }
}
